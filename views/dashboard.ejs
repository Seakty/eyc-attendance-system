<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background: #f5f7fb;
        margin: 0;
        color: #1f2937;
      }
      .container {
        max-width: 980px;
        margin: 40px auto;
        padding: 24px;
      }
      .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 18px;
        margin-bottom: 24px;
      }
      .card {
        padding: 20px;
        background: white;
        border-radius: 12px;
        box-shadow: 0 3px 14px rgba(15, 23, 42, 0.08);
      }
      .label {
        font-size: 12px;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }
      .value {
        font-size: 2rem;
        font-weight: 700;
        margin-top: 8px;
      }
      .status {
        margin-top: 12px;
        color: #1d4ed8;
        font-weight: 600;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        background: white;
        border-radius: 10px;
        overflow: hidden;
      }
      th, td {
        text-align: left;
        padding: 12px 14px;
        border-bottom: 1px solid #e5e7eb;
      }
      th {
        background: #eef2ff;
      }
      .nav {
        display: flex;
        gap: 12px;
      }
      .nav a {
        text-decoration: none;
        color: #1f2937;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>Admin Dashboard</h1>
        <nav class="nav">
          <a href="/dashboard">Dashboard</a>
          <a href="/staff">Staff</a>
          <a href="/reports">Reports</a>
        </nav>
      </div>

      <div class="grid">
        <div class="card">
          <div class="label">Total Staff</div>
          <div class="value" id="totalStaff">--</div>
        </div>
        <div class="card">
          <div class="label">On Time</div>
          <div class="value" id="onTime">--</div>
        </div>
        <div class="card">
          <div class="label">Late</div>
          <div class="value" id="late">--</div>
        </div>
        <div class="card">
          <div class="label">Absent</div>
          <div class="value" id="absent">--</div>
        </div>
      </div>

      <div class="card">
        <div class="status" id="summaryStatus">Loading dashboard...</div>
      </div>
    </div>

    <script>
      async function loadDashboard() {
        const token = localStorage.getItem('eyc_auth_token');
        const res = await fetch('/api/admin/dashboard', {
          headers: {
            Authorization: `Bearer ${token}`
          }
        });
        const data = await res.json();

        if (!res.ok) {
          document.getElementById('summaryStatus').textContent = data.message || 'Unable to load dashboard.';
          return;
        }

        const summary = data.summary || {};
        document.getElementById('totalStaff').textContent = summary.totalStaff ?? 0;
        document.getElementById('onTime').textContent = summary.onTime ?? 0;
        document.getElementById('late').textContent = summary.late ?? 0;
        document.getElementById('absent').textContent = summary.absent ?? 0;
        document.getElementById('summaryStatus').textContent = 'Dashboard refreshed successfully.';
      }

      loadDashboard();
    </script>
  </body>
</html>
