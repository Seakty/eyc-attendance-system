<%
  // ============================================================
  // REUSABLE ADMIN SIDEBAR
  // Expects two locals from the page render:
  //   user : req.session.user  (id / name / role)
  //   path : req.path          (used for the active highlight)
  // Both are read defensively so a page can never 500 just because it
  // forgot to pass one of them.
  // ============================================================

  const currentPath = (typeof path !== "undefined" && path) || "";
  const currentUser = (typeof user !== "undefined" && user) || null;

  const userName =
    (currentUser && currentUser.name) || "Admin";

  const userInitials =
    userName
      .split(" ")
      .filter(Boolean)
      .map((part) => part[0])
      .join("")
      .substring(0, 2)
      .toUpperCase() || "AD";

  // Exact match, plus nested routes such as /admin/reports/2026-10
  const isActive = (target) =>
    currentPath === target || currentPath.startsWith(target + "/");

  const navLinkClass = (target) =>
    isActive(target)
      ? "flex items-center gap-3 px-4 py-3 rounded-xl bg-indigo-50 text-indigo-600 font-semibold"
      : "flex items-center gap-3 px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-100";
%>
<!-- Top route progress bar (shared by every admin page) -->
<div
  id="routeProgress"
  class="fixed top-0 left-0 z-[100] h-[3px] w-0 bg-gradient-to-r from-indigo-500 via-indigo-500 to-indigo-600 pointer-events-none"
  style="opacity: 0; transition: width 0.2s ease, opacity 0.3s ease"
  aria-hidden="true"
></div>

<aside
  class="no-print hidden lg:flex w-64 bg-white border-r border-slate-200 flex-col"
>
  <!-- Logo -->
  <a
    href="/admin/dashboard"
    class="h-20 flex items-center px-6 border-b border-slate-200 hover:bg-slate-50 transition-colors duration-200"
  >
    <!-- Framed Logo -->
    <div
      class="relative flex items-center justify-center p-1.5 bg-white rounded-xl border border-slate-200 shadow-sm"
    >
      <img
        src="/images/eyc-logo.png"
        alt="EYC Logo"
        class="w-8 h-8 object-contain"
      />
    </div>

    <!-- Consistent Typography -->
    <div class="ml-3.5 flex flex-col justify-center">
      <h1 class="font-extrabold text-lg tracking-tight text-indigo-700">EYC</h1>
      <p
        class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-0.5"
      >
        Attendance
      </p>
    </div>
  </a>

  <!-- Navigation -->
  <nav class="flex-1 p-4 space-y-2">
    <p class="px-3 pt-2 pb-3 text-xs font-semibold text-slate-400 uppercase">
      Main Menu
    </p>

    <a href="/admin/dashboard" class="<%= navLinkClass('/admin/dashboard') %>">
      <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
      Dashboard
    </a>

    <a href="/admin/staff" class="<%= navLinkClass('/admin/staff') %>">
      <i data-lucide="users" class="w-5 h-5"></i>
      Staff
    </a>

    <a href="/admin/reports" class="<%= navLinkClass('/admin/reports') %>">
      <i data-lucide="bar-chart-3" class="w-5 h-5"></i>
      Reports &amp; Analytics
    </a>

    <p class="px-3 pt-7 pb-3 text-xs font-semibold text-slate-400 uppercase">
      System
    </p>

    <a href="/admin/settings" class="<%= navLinkClass('/admin/settings') %>">
      <i data-lucide="settings" class="w-5 h-5"></i>
      Settings
    </a>
  </nav>

  <!-- User -->
  <div class="p-4 border-t border-slate-200">
    <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-50">
      <div
        class="w-10 h-10 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center font-bold"
      >
        <%= userInitials %>
      </div>

      <div class="flex-1 min-w-0">
        <p class="font-semibold text-sm truncate"><%= userName %></p>
        <p class="text-xs text-slate-500 truncate">Administrator</p>
      </div>

      <button
        onclick="logout()"
        title="Log out"
        class="text-slate-400 hover:text-slate-700"
      >
        <i data-lucide="log-out" class="w-5 h-5"></i>
      </button>
    </div>
  </div>
</aside>

<script>
  // The logout button lives in this partial, so every page that includes the
  // sidebar gets a working one. Pages that already ship their own logout()
  // (dashboard, reports) keep theirs: this only fills the gap.
  if (typeof logout !== "function") {
    window.logout = async function logout() {
      try {
        await fetch("/api/auth/logout", { method: "POST" });
      } finally {
        localStorage.removeItem("eyc_auth_token");
        localStorage.removeItem("eyc_user");
        window.location.href = "/login";
      }
    };
  }
</script>

<script>
  // ============================================================
  // Top route progress indicator
  // Shows while a full-page admin navigation is in flight. AJAX
  // forms (marked data-ajax) handle their own inline spinners.
  // ============================================================
  (function () {
    const bar = document.getElementById("routeProgress");
    if (!bar) return;

    let active = false;
    let timer = null;
    let fadeTimer = null;
    let resetTimer = null;

    function start() {
      if (active) return;
      active = true;

      // Cancel any pending fade/reset from the previous navigation.
      clearTimeout(fadeTimer);
      clearTimeout(resetTimer);

      let progress = 8;
      bar.style.opacity = "1";
      bar.style.width = progress + "%";

      clearInterval(timer);
      timer = setInterval(function () {
        progress += Math.max(1, (90 - progress) * 0.08);
        if (progress >= 90) {
          progress = 90;
          clearInterval(timer);
        }
        bar.style.width = progress + "%";
      }, 180);
    }

    function done() {
      if (!active) return;
      active = false;

      clearInterval(timer);
      bar.style.width = "100%";

      fadeTimer = setTimeout(function () {
        if (active) return;
        bar.style.opacity = "0";

        resetTimer = setTimeout(function () {
          if (!active) bar.style.width = "0%";
        }, 300);
      }, 180);
    }

    function isPlainLeftClick(event) {
      return (
        event.button === 0 &&
        !event.metaKey &&
        !event.ctrlKey &&
        !event.shiftKey &&
        !event.altKey
      );
    }

    function shouldIgnoreLink(link, event) {
      if (!link) return true;
      if (event.defaultPrevented || !isPlainLeftClick(event)) return true;
      if (link.target && link.target !== "_self") return true;
      if (link.hasAttribute("download")) return true;

      const rawHref = link.getAttribute("href");
      if (!rawHref || rawHref.startsWith("#")) return true;
      if (rawHref.toLowerCase().startsWith("javascript:")) return true;

      const url = new URL(link.href, window.location.href);
      if (url.origin !== window.location.origin) return true;

      // Same-page hash links do not trigger a navigation.
      if (
        url.pathname === window.location.pathname &&
        url.search === window.location.search &&
        url.hash
      ) {
        return true;
      }

      return false;
    }

    // Links: the document listener runs after target handlers, so
    // event.defaultPrevented already reflects any cancellation.
    document.addEventListener("click", function (event) {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const link = target.closest("a[href]");
      if (shouldIgnoreLink(link, event)) return;

      start();
    });

    // Regular form submissions (search, month picker, etc.)
    document.addEventListener("submit", function (event) {
      const form = event.target;
      if (!(form instanceof HTMLFormElement)) return;
      if (event.defaultPrevented) return;
      if (form.dataset.ajax === "true" || form.hasAttribute("data-ajax")) return;
      if (form.target && form.target !== "_self") return;

      start();
    });

    // The page itself is loading: show progress until it is ready.
    if (document.readyState !== "complete") {
      start();
      window.addEventListener("load", done, { once: true });
    }

    // Restore the bar if the browser serves the page from bfcache.
    window.addEventListener("pageshow", function (event) {
      if (event.persisted) done();
    });
  })();
</script>
