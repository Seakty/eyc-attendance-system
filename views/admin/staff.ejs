  <!-- =====================================================
       JAVASCRIPT
  ====================================================== -->

  <script>

    lucide.createIcons();


    // ======================================================
    // GLOBAL DATA
    // ======================================================

    let staffList = [];
    let campusList = [];


    // ======================================================
    // ALERT
    // ======================================================

    function showAlert(message, type = "success") {

      const alertBox = document.getElementById("alertBox");

      alertBox.textContent = message;

      alertBox.className =
        "rounded-xl px-4 py-3 text-sm font-medium";

      if (type === "success") {

        alertBox.classList.add(
          "bg-emerald-50",
          "text-emerald-700",
          "border",
          "border-emerald-200"
        );

      } else {

        alertBox.classList.add(
          "bg-red-50",
          "text-red-700",
          "border",
          "border-red-200"
        );

      }

      alertBox.classList.remove("hidden");

      setTimeout(() => {
        alertBox.classList.add("hidden");
      }, 4000);
    }


    // ======================================================
    // LOAD STAFF
    // ======================================================

    async function loadStaff() {

      const table = document.getElementById("staffTable");

      try {

        const response = await fetch("/api/admin/staff");

        if (!response.ok) {
          throw new Error("Failed to load staff.");
        }

        const result = await response.json();

        if (result.status !== "success") {
          throw new Error(result.message || "API returned an error.");
        }

        staffList = result.data || [];
        campusList = result.campuses || [];

        renderStaff(staffList);

      } catch (error) {

        console.error(error);

        table.innerHTML = `
          <tr>
            <td
              colspan="6"
              class="px-6 py-10 text-center text-red-500"
            >
              Could not load staff members.
            </td>
          </tr>
        `;

        showAlert(
          error.message || "Could not load staff members.",
          "error"
        );
      }
    }


    // ======================================================
    // RENDER STAFF
    // ======================================================

    function renderStaff(list) {

      const table = document.getElementById("staffTable");

      document.getElementById("staffCount").textContent =
        list.length;


      if (list.length === 0) {

        table.innerHTML = `
          <tr>
            <td
              colspan="6"
              class="px-6 py-10 text-center text-slate-500"
            >
              No staff members found.
            </td>
          </tr>
        `;

        return;
      }


      table.innerHTML = list.map((staff) => {

        const initials = staff.full_name
          .split(" ")
          .map((name) => name[0])
          .join("")
          .substring(0, 2)
          .toUpperCase();


        const statusClass = staff.is_active
         ? "bg-emerald-20 text-emerald-700 border-emerald-500/60"
        : "bg-red-10 text-red-500 border-red-500/60";
        const dotClass = staff.is_active ? "bg-emerald-500" : "bg-red-500";
        const statusDot = `
          <span class="relative flex h-2 w-2 mr-1.5">
            ${staff.is_active ? '<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>' : ''}
            <span class="relative inline-flex rounded-full h-2 w-2 ${dotClass}"></span>
          </span>
        `;      
        const statusText = `
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold border ${statusClass}">
            ${statusDot}
            ${staff.is_active ? "Active" : "Inactive"}
          </span>
        `;

        // const statusText = staff.is_active
        //   ? "• Active"
        //   : "• Inactive";


        return `
          <tr class="hover:bg-slate-50 transition">

            <td class="px-6 py-4">

              <div class="flex items-center gap-3">

                <div
                  class="w-10 h-10 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center font-semibold"
                >
                  ${escapeHtml(initials)}
                </div>

                <div>

                  <p class="font-semibold text-slate-900">
                    ${escapeHtml(staff.full_name)}
                  </p>

                  <p class="text-xs text-slate-500">
                    ID #${staff.id}
                  </p>

                </div>

              </div>

            </td>


            <td class="px-6 py-4 text-slate-600">
              ${escapeHtml(staff.position || "—")}
            </td>


            <td class="px-6 py-4 text-slate-600">
              ${escapeHtml(staff.campus_name || "—")}
            </td>


            <td class="px-6 py-4 text-slate-600">
              ${escapeHtml(staff.phone || "—")}
            </td>


            <td class="px-6 py-4">

              <span
                class="inline-flex px-2.5 py-1 rounded-full text-xs font-semibold ${statusClass}"
              >
                ${statusText}
              </span>

            </td>


            <td class="px-6 py-4">

              <div class="flex justify-end gap-2">

                <button
                  onclick="openEditModal(${staff.id})"
                  title="Edit"
                  class="w-9 h-9 rounded-lg border bg-yellow-100 border-slate-200 text-slate-500 hover:text-indigo-600 hover:bg-indigo-50 flex items-center justify-center"
                >
                  <i
                    data-lucide="pencil"
                    class="w-4 h-4"
                  ></i>
                </button>


                <button
                  onclick="openPasswordModal(${staff.id})"
                  title="Reset Password"
                  class="w-9 h-9 rounded-lg border bg-indigo-100 border-slate-200 text-slate-500 hover:text-indigo-600 hover:bg-indigo-50 flex items-center justify-center"
                >
                  <i
                    data-lucide="key-round"
                    class="w-4 h-4"
                  ></i>
                </button>


                ${
                  staff.is_active

                    ? `

                      <button
                        onclick="deactivateStaff(${staff.id})"
                        title="Deactivate"
                        class="w-9 h-9 rounded-lg border bg-red-100 border-red-200 text-red-500 hover:text-red-600 hover:bg-red-50 flex items-center justify-center"
                      >
                        <i
                          data-lucide="user-x"
                          class="w-4 h-4"
                        ></i>
                      </button>

                    `

                    : `

                      <button
                        onclick="activateStaff(${staff.id})"
                        title="Activate"
                        class="w-9 h-9 rounded-lg border bg-emerald-100 border-emerald-200 text-emerald-500 hover:text-emerald-600 hover:bg-emerald-50 flex items-center justify-center"
                      >
                        <i
                          data-lucide="user-check"
                          class="w-4 h-4"
                        ></i>
                      </button>

                    `
                }

              </div>

            </td>

          </tr>
        `;

      }).join("");


      lucide.createIcons();
    }


    // ======================================================
    // SEARCH
    // ======================================================

    document
      .getElementById("searchInput")
      .addEventListener("input", function () {

        const search = this.value
          .trim()
          .toLowerCase();


        const filtered = staffList.filter((staff) => {

          return (

            staff.full_name
              .toLowerCase()
              .includes(search)

            ||

            (staff.position || "")
              .toLowerCase()
              .includes(search)

            ||

            (staff.campus_name || "")
              .toLowerCase()
              .includes(search)

            ||

            (staff.phone || "")
              .toLowerCase()
              .includes(search)

          );

        });


        renderStaff(filtered);

      });


    // ======================================================
    // EDIT MODAL
    // ======================================================

    function openEditModal(id) {

      const staff = staffList.find(
        (item) => Number(item.id) === Number(id)
      );

      if (!staff) {
        showAlert("Staff member not found.", "error");
        return;
      }


      document.getElementById("editStaffId").value =
        staff.id;

      document.getElementById("editFullName").value =
        staff.full_name || "";

      document.getElementById("editPosition").value =
        staff.position || "";

      document.getElementById("editPhone").value =
        staff.phone || "";


      const campusSelect =
        document.getElementById("editCampus");


      campusSelect.innerHTML =
        campusList.map((campus) => {

          const selected =
            Number(campus.id) === Number(staff.campus_id)
              ? "selected"
              : "";

          return `
            <option
              value="${campus.id}"
              ${selected}
            >
              ${escapeHtml(campus.name)}
            </option>
          `;

        }).join("");


      const modal =
        document.getElementById("editModal");

      modal.classList.remove("hidden");
      modal.classList.add("flex");


      lucide.createIcons();
    }


    function closeEditModal() {

      const modal =
        document.getElementById("editModal");

      modal.classList.add("hidden");
      modal.classList.remove("flex");

    }


    // ======================================================
    // SAVE EDIT
    // ======================================================

    document
      .getElementById("editForm")
      .addEventListener("submit", async function (event) {

        event.preventDefault();


        const id =
          document.getElementById("editStaffId").value;


        const body = {

          full_name:
            document.getElementById("editFullName").value.trim(),

          position:
            document.getElementById("editPosition").value.trim(),

          campus_id:
            Number(document.getElementById("editCampus").value),

          phone:
            document.getElementById("editPhone").value.trim(),

        };


        try {

          const response = await fetch(
            `/api/admin/staff/${id}`,
            {
              method: "PUT",

              headers: {
                "Content-Type": "application/json",
              },

              body: JSON.stringify(body),
            }
          );


          const result = await response.json();


          if (!response.ok || result.status !== "success") {

            throw new Error(
              result.message || "Could not update staff."
            );

          }


          closeEditModal();

          showAlert(
            "Staff profile updated successfully."
          );

          await loadStaff();

        } catch (error) {

          console.error(error);

          showAlert(
            error.message || "Could not update staff.",
            "error"
          );

        }

      });


    // ======================================================
    // PASSWORD MODAL
    // ======================================================

    function openPasswordModal(id) {

      const staff = staffList.find(
        (item) => Number(item.id) === Number(id)
      );

      if (!staff) {
        showAlert("Staff member not found.", "error");
        return;
      }


      document.getElementById("passwordStaffId").value =
        staff.id;


      document.getElementById("passwordStaffName").textContent =
        `Set a new password for ${staff.full_name}`;


      document.getElementById("newPassword").value = "";

      document.getElementById("confirmPassword").value = "";


      const modal =
        document.getElementById("passwordModal");

      modal.classList.remove("hidden");
      modal.classList.add("flex");

    }


    function closePasswordModal() {

      const modal =
        document.getElementById("passwordModal");

      modal.classList.add("hidden");
      modal.classList.remove("flex");

    }


    // ======================================================
    // RESET PASSWORD
    // ======================================================

    document
      .getElementById("passwordForm")
      .addEventListener("submit", async function (event) {

        event.preventDefault();


        const id =
          document.getElementById("passwordStaffId").value;


        const password =
          document.getElementById("newPassword").value;


        const confirmPassword =
          document.getElementById("confirmPassword").value;


        if (password !== confirmPassword) {

          showAlert(
            "Passwords do not match.",
            "error"
          );

          return;
        }


        try {

          const response = await fetch(
            `/api/admin/staff/${id}/reset-password`,
            {
              method: "POST",

              headers: {
                "Content-Type": "application/json",
              },

              body: JSON.stringify({
                new_password: password,
              }),
            }
          );


          const result =
            await response.json();


          if (
            !response.ok ||
            result.status !== "success"
          ) {

            throw new Error(
              result.message ||
              "Could not reset password."
            );

          }


          closePasswordModal();

          showAlert(
            "Password reset successfully."
          );

        } catch (error) {

          console.error(error);

          showAlert(
            error.message ||
            "Could not reset password.",
            "error"
          );

        }

      });


    // ======================================================
    // DEACTIVATE
    // ======================================================

    async function deactivateStaff(id) {

      const staff =
        staffList.find(
          (item) =>
            Number(item.id) === Number(id)
        );


      if (!staff) return;


      const confirmed =
        confirm(
          `Deactivate ${staff.full_name}'s account?`
        );


      if (!confirmed) return;


      try {

        const response =
          await fetch(
            `/api/admin/staff/${id}/deactivate`,
            {
              method: "PATCH",
            }
          );


        const result =
          await response.json();


        if (
          !response.ok ||
          result.status !== "success"
        ) {

          throw new Error(
            result.message ||
            "Could not deactivate staff."
          );

        }


        showAlert(
          `${staff.full_name} has been deactivated.`
        );


        await loadStaff();

      } catch (error) {

        console.error(error);

        showAlert(
          error.message ||
          "Could not deactivate staff.",
          "error"
        );

      }

    }


    // ======================================================
    // ACTIVATE
    // ======================================================
    async function activateStaff(id) {
      const staff =
        staffList.find(
          (item) =>
            Number(item.id) === Number(id)
        );
      if (!staff) return;
      const confirmed =
        confirm(
          `Reactivate ${staff.full_name}'s account?`
        );
      if (!confirmed) return;
      try {
        const response =
          await fetch(
            `/api/admin/staff/${id}/activate`,
            {
              method: "PATCH",
            }
          );
        const result =
          await response.json();
        if (
          !response.ok ||
          result.status !== "success"
        ) {

          throw new Error(
            result.message ||
            "Could not activate staff."
          );
        }
        showAlert(
          `${staff.full_name} has been reactivated.`
        );
        await loadStaff();
      } catch (error) {
        console.error(error);
        showAlert(
          error.message ||
          "Could not activate staff.",
          "error"
        );
      }
    }
  
    // ======================================================
    // HTML ESCAPE
    // ======================================================
    function escapeHtml(value) {
      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

    }
    // ======================================================
    // INITIAL LOAD
    // ======================================================
    loadStaff();

  </script>
