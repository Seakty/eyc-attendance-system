    <script>
      // Activate Lucide icons
      lucide.createIcons();

      // Search attendance table
      function searchTable() {
        const input = document
          .getElementById("searchInput")
          .value.toLowerCase();

        const rows = document
          .getElementById("attendanceTable")
          .getElementsByTagName("tr");

        for (let i = 0; i < rows.length; i++) {
          const text = rows[i].textContent.toLowerCase();

          rows[i].style.display = text.includes(input) ? "" : "none";
        }
      }

      // ==========================================
      // ADM-01 REQUIREMENT #4
      // Auto refresh every 15 seconds
      // ==========================================

          setInterval(function () {
            console.log("Refreshing attendance data...");

            loadAttendanceSummary();
            loadTodayAttendance();
          }, 15000);

      async function loadAttendanceSummary() {
        try {
          const response = await fetch("/api/attendance/summary");

          if (!response.ok) {
            throw new Error("Failed to load attendance summary");
          }

          const result = await response.json();

          if (result.status !== "success") {
            throw new Error("API returned an error");
          }

          const data = result.data;

          document.getElementById("totalPresent").textContent =
            data.totalPresent;

          document.getElementById("lateCount").textContent = data.late;

          document.getElementById("absentCount").textContent = data.absent;

          document.getElementById("flaggedScans").textContent =
            data.flaggedScans;
        } catch (error) {
          console.error("Could not load attendance summary:", error);
        }
      }
      async function loadTodayAttendance() {
  try {
    const response = await fetch("/api/attendance/today");

    if (!response.ok) {
      throw new Error("Failed to load today's attendance");
    }

    const result = await response.json();

    if (result.status !== "success") {
      throw new Error("API returned an error");
    }

    const table = document.getElementById("attendanceTable");

    table.innerHTML = "";

    if (result.data.length === 0) {
      table.innerHTML = `
        <tr>
          <td colspan="6" class="px-6 py-8 text-center text-slate-500">
            No attendance records for today.
          </td>
        </tr>
      `;
      return;
    }

    result.data.forEach((record) => {
      const checkIn = record.check_in_at
        ? new Date(record.check_in_at).toLocaleTimeString([], {
            hour: "2-digit",
            minute: "2-digit",
          })
        : "—";

      const checkOut = record.check_out_at
        ? new Date(record.check_out_at).toLocaleTimeString([], {
            hour: "2-digit",
            minute: "2-digit",
          })
        : "—";

      const statusClass =
        record.status === "Late"
          ? "bg-amber-50 text-amber-700"
          : record.status === "Absent"
          ? "bg-red-50 text-red-700"
          : "bg-emerald-50 text-emerald-700";

      const dotClass =
        record.status === "Late"
          ? "bg-amber-500"
          : record.status === "Absent"
          ? "bg-red-500"
          : "bg-emerald-500";

      const initials = record.full_name
        .split(" ")
        .map((name) => name[0])
        .join("")
        .substring(0, 2)
        .toUpperCase();

      table.innerHTML += `
        <tr class="hover:bg-slate-50 transition">
          <td class="px-6 py-4">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center font-semibold">
                ${initials}
              </div>

              <div>
                <p class="font-semibold text-slate-900">
                  ${record.full_name}
                </p>
                <p class="text-xs text-slate-500">
                  ${record.position || "Staff"}
                </p>
              </div>
            </div>
          </td>

          <td class="px-6 py-4 text-slate-600">
            ${record.campus_name || "—"}
          </td>

          <td class="px-6 py-4 font-medium">
            ${checkIn}
          </td>

          <td class="px-6 py-4 font-medium">
            ${checkOut}
          </td>

          <td class="px-6 py-4">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full ${statusClass} text-xs font-semibold">
              <span class="w-1.5 h-1.5 rounded-full ${dotClass}"></span>
              ${record.status}
            </span>
          </td>

          <td class="px-6 py-4">
            <button class="text-slate-400 hover:text-indigo-600">
              <i data-lucide="more-horizontal" class="w-5 h-5"></i>
            </button>
          </td>
        </tr>
      `;
    });

    lucide.createIcons();
  } catch (error) {
    console.error("Could not load today's attendance:", error);
  }
}
      loadAttendanceSummary();
      loadTodayAttendance();
    </script>
