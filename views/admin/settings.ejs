<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>EYC Attendance - Campus Settings</title>

  <link rel="icon" type="image/png" href="/images/favicon.ico" />

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Leaflet Map & Geosearch CSS/JS (Free, No API Key Required) -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <link rel="stylesheet" href="https://unpkg.com/leaflet-geosearch@3.11.0/dist/geosearch.css" />
  <script src="https://unpkg.com/leaflet-geosearch@3.11.0/dist/geosearch.umd.js"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: "#4f46e5",
            secondary: "#6366f1",
          },
          fontFamily: {
            sans: ["Inter", "sans-serif"],
          },
        },
      },
    };
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <style>
    body {
      font-family: "Inter", sans-serif;
    }

    #map {
      z-index: 1;
    }

    .leaflet-control-geosearch form {
      border-radius: 12px !important;
      border: 1px solid #e2e8f0 !important;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08) !important;
    }

    @media print {
      * {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      @page {
        margin: 0; 
      }
      body * {
        visibility: hidden;
      }
      #printable-poster, #printable-poster * {
        visibility: visible;
      }
      #printable-poster {
        position: absolute;
        left: 50%;
        top: 5%;
        transform: translateX(-50%);
        width: 85%;
        box-shadow: none !important;
        border: 2px solid #4f46e5 !important;
      }
      .no-print {
        display: none !important;
      }
    }
  </style>
</head>

<body class="bg-[#F9F7F6] text-slate-800">

  <div class="flex min-h-screen">
    
    <!-- SIDEBAR -->
    <aside class="no-print hidden lg:flex w-64 bg-white border-r border-slate-200 flex-col">
      <!-- Logo Header -->
      <div class="h-20 flex items-center px-6 border-b border-slate-200">
        <div class="w-10 h-10 rounded-xl bg-indigo-600 flex items-center justify-center text-white font-bold text-lg">
          E
        </div>
        <div class="ml-3">
          <h1 class="font-bold text-lg text-slate-900">EYC</h1>
          <p class="text-xs text-slate-500">Attendance System</p>
        </div>
      </div>
      <a href="/admin/dashboard" class="h-20 flex items-center px-6 border-b border-slate-200 hover:bg-slate-50 transition-colors duration-200">
        <div class="relative flex items-center justify-center p-1.5 bg-white rounded-xl border border-slate-200 shadow-sm">
          <img src="/images/eyc-logo.png" alt="EYC Logo" class="w-8 h-8 object-contain" />
        </div>
        
        <div class="ml-3.5 flex flex-col justify-center">
          <h1 class="font-extrabold text-lg tracking-tight text-indigo-700">
            EYC
          </h1>
          <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-0.5">
            Attendance
          </p>
        </div>
      </a>

      <!-- Navigation -->
      <nav class="flex-1 p-4 space-y-2">
        <p class="px-3 pt-2 pb-3 text-xs font-semibold text-slate-400 uppercase">
          Main Menu
        </p>

        <a href="/admin/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-100">
          <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
          Dashboard
        </a>

        <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-100">
          <i data-lucide="users" class="w-5 h-5"></i>
          Staff
        </a>

        <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-100">
          <i data-lucide="calendar-check" class="w-5 h-5"></i>
          Attendance
        </a>

        <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-100">
          <i data-lucide="file-text" class="w-5 h-5"></i>
          Reports
        </a>

        <p class="px-3 pt-7 pb-3 text-xs font-semibold text-slate-400 uppercase">
          System
        </p>

        <a href="/admin/settings" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-indigo-50 text-indigo-600 font-semibold">
          <i data-lucide="settings" class="w-5 h-5"></i>
          Settings
        </a>
      </nav>

      <!-- User Profile -->
      <div class="p-4 border-t border-slate-200">
        <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-50">
          <div class="w-10 h-10 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center font-bold">
            AD
          </div>
          <div class="flex-1 min-w-0">
            <p class="font-semibold text-sm truncate">Admin</p>
            <p class="text-xs text-slate-500 truncate">Administrator</p>
          </div>
        </div>
      </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="flex-1 min-w-0">
      
      <header class="no-print h-20 bg-white border-b border-slate-200 flex items-center justify-between px-5 lg:px-8">
        <div>
          <h2 class="text-xl font-bold text-slate-900">Campus Settings</h2>
          <p class="text-sm text-slate-500">Configure parameters & download QR code posters</p>
        </div>

        <div class="flex items-center gap-3">
          <button class="relative w-10 h-10 rounded-xl border border-slate-200 flex items-center justify-center hover:bg-slate-50">
            <i data-lucide="bell" class="w-5 h-5 text-slate-600"></i>
            <span class="absolute top-2 right-2 w-2 h-2 bg-red-500 rounded-full"></span>
          </button>
        </div>
      </header>

      <div class="p-5 lg:p-8 space-y-8 max-w-4xl mx-auto">

        <!-- Form Card -->
        <div class="no-print bg-white border border-slate-200 shadow-sm rounded-2xl p-6 lg:p-8">
          
          <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
              <i data-lucide="map-pin" class="w-5 h-5"></i>
            </div>
            <div>
              <h3 class="text-lg font-bold text-slate-900">Location & Attendance Rules</h3>
              <p class="text-xs text-slate-500">Update coordinates and cutoff times for attendance check-ins</p>
            </div>
          </div>

          <form action="/admin/settings" method="POST" class="space-y-6">
            
            <!-- Late Cutoff Time -->
            <div>
              <label for="late_cutoff_time" class="block text-xs font-semibold text-slate-600 uppercase mb-2">
                Late Cutoff Time <span class="text-red-500">*</span>
              </label>
              <input
                type="time"
                id="late_cutoff_time"
                name="late_cutoff_time"
                value="<%= settings && settings.late_cutoff_time ? settings.late_cutoff_time : '08:15' %>"
                required
                class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition text-sm"
              />
            </div>

            <!-- Leaflet Map Container with Locate Button -->
            <div>
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
                <label class="block text-xs font-semibold text-slate-600 uppercase">
                  Select Campus Location on Map
                </label>
                
                <!-- GPS Locate Me Button -->
                <button
                  type="button"
                  id="locate-btn"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-indigo-50 hover:bg-indigo-100 text-indigo-600 rounded-lg text-xs font-semibold transition border border-indigo-200 shadow-sm"
                >
                  <i data-lucide="locate-fixed" class="w-4 h-4"></i>
                  Use My Current GPS Location
                </button>
              </div>
              
              <div id="map" class="w-full h-80 rounded-xl border border-slate-200 shadow-sm overflow-hidden z-0"></div>
            </div>

            <!-- Coordinate Input Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <!-- Latitude -->
              <div>
                <label for="school_lat" class="block text-xs font-semibold text-slate-600 uppercase mb-2">
                  School Latitude <span class="text-red-500">*</span>
                </label>
                <input
                  type="number"
                  step="any"
                  id="school_lat"
                  name="school_lat"
                  value="<%= settings && settings.school_lat ? settings.school_lat : '11.5564' %>"
                  placeholder="e.g. 11.5564"
                  required
                  class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition text-sm"
                />
              </div>

              <!-- Longitude -->
              <div>
                <label for="school_lng" class="block text-xs font-semibold text-slate-600 uppercase mb-2">
                  School Longitude <span class="text-red-500">*</span>
                </label>
                <input
                  type="number"
                  step="any"
                  id="school_lng"
                  name="school_lng"
                  value="<%= settings && settings.school_lng ? settings.school_lng : '104.9282' %>"
                  placeholder="e.g. 104.9282"
                  required
                  class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition text-sm"
                />
              </div>
            </div>

            <!-- Allowed GPS Radius -->
            <div>
              <label for="gps_radius_meters" class="block text-xs font-semibold text-slate-600 uppercase mb-2">
                Allowed GPS Radius (meters) <span class="text-red-500">*</span>
              </label>
              <input
                type="number"
                id="gps_radius_meters"
                name="gps_radius_meters"
                value="<%= settings && settings.gps_radius_meters ? settings.gps_radius_meters : '50' %>"
                placeholder="e.g. 50"
                required
                class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition text-sm"
              />
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 rounded-xl transition shadow-sm text-sm"
            >
              Save Settings & Generate QR Code
            </button>
          </form>
        </div>

        <!-- Entrance QR Poster Display Section -->
        <% if (typeof qrCodeUrl !== 'undefined' && qrCodeUrl) { %>
          <div class="space-y-4">
            
            <div class="no-print flex flex-col sm:flex-row gap-3 justify-end">
              <button
                onclick="window.print()"
                class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2.5 rounded-xl font-semibold text-sm transition flex items-center justify-center gap-2 shadow-sm"
              >
                <i data-lucide="printer" class="w-4 h-4"></i>
                Print Poster
              </button>

              <a
                href="<%= qrCodeUrl %>"
                download="EYC-Entrance-QR.png"
                class="bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 px-5 py-2.5 rounded-xl font-semibold text-sm transition flex items-center justify-center gap-2 text-center shadow-sm"
              >
                <i data-lucide="download" class="w-4 h-4 text-indigo-600"></i>
                Download Image
              </a>
            </div>

            <div id="printable-poster" class="bg-white border border-slate-200 shadow-sm rounded-2xl p-8 text-center space-y-6">
              <div class="flex justify-center items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-indigo-600 flex items-center justify-center text-white font-bold text-xl">
                  E
                </div>
                <div class="text-left">
                  <h1 class="font-bold text-xl text-slate-900">EYC</h1>
                  <p class="text-xs text-slate-500">Empowering Youth in Cambodia</p>
                </div>
              </div>

              <div>
                <h2 class="text-slate-900 text-2xl font-bold tracking-wide uppercase">ENTRANCE QR CODE</h2>
                <p class="text-indigo-600 text-sm font-semibold mt-1">Scan to Mark Daily Attendance</p>
              </div>

              <div class="flex justify-center">
                <div class="p-4 bg-slate-50 border-2 border-indigo-600 rounded-2xl inline-block shadow-sm">
                  <img src="<%= qrCodeUrl %>" alt="Entrance QR Code" class="w-64 h-64 object-contain" />
                </div>
              </div>

              <div class="max-w-md mx-auto space-y-1">
                <p class="text-slate-900 font-semibold text-sm">Please open your EYC Mobile App to scan</p>
                <p class="text-slate-500 text-xs">Align the QR scanner within the frame to record check-in or check-out times.</p>
              </div>
            </div>

          </div>
        <% } %>

        <p class="no-print text-center text-xs text-slate-400 pt-4">
          © <%= new Date().getFullYear() %> Empowering Youth in Cambodia (EYC)
        </p>

      </div>
    </main>
  </div>

  <script>
    lucide.createIcons();

    // Map Initialization
    document.addEventListener("DOMContentLoaded", function () {
      const latInput = document.getElementById('school_lat');
      const lngInput = document.getElementById('school_lng');
      const locateBtn = document.getElementById('locate-btn');

      const defaultLat = parseFloat(latInput.value) || 11.5564;
      const defaultLng = parseFloat(lngInput.value) || 104.9282;

      const map = L.map('map').setView([defaultLat, defaultLng], 15);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '© OpenStreetMap contributors'
      }).addTo(map);

      const marker = L.marker([defaultLat, defaultLng], { draggable: true }).addTo(map);

      function updateInputs(lat, lng) {
        latInput.value = parseFloat(lat).toFixed(7);
        lngInput.value = parseFloat(lng).toFixed(7);
      }

      marker.on('dragend', function (e) {
        const pos = e.target.getLatLng();
        updateInputs(pos.lat, pos.lng);
      });

      map.on('click', function (e) {
        marker.setLatLng(e.latlng);
        updateInputs(e.latlng.lat, e.latlng.lng);
      });

      const provider = new GeoSearch.OpenStreetMapProvider();
      const searchControl = new GeoSearch.GeoSearchControl({
        provider: provider,
        style: 'bar',
        showMarker: false,
        showPopup: false,
        autoClose: true,
        retainZoomLevel: false,
        animateZoom: true,
        keepResult: true,
        searchLabel: 'Search campus, street, or area...',
      });

      map.addControl(searchControl);

      map.on('geosearch/showlocation', function (result) {
        const { x, y } = result.location;
        marker.setLatLng([y, x]);
        updateInputs(y, x);
      });

      // Browser GPS Geolocation Handler
      locateBtn.addEventListener('click', function () {
        if ("geolocation" in navigator) {
          locateBtn.innerHTML = `<i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i> Detecting Location...`;
          lucide.createIcons();

          navigator.geolocation.getCurrentPosition(
            function (position) {
              const lat = position.coords.latitude;
              const lng = position.coords.longitude;

              marker.setLatLng([lat, lng]);
              map.setView([lat, lng], 17);
              updateInputs(lat, lng);

              locateBtn.innerHTML = `<i data-lucide="locate-fixed" class="w-4 h-4"></i> Use My Current GPS Location`;
              lucide.createIcons();
            },
            function (error) {
              alert("Could not detect location. Please enable location permissions in your browser.");
              locateBtn.innerHTML = `<i data-lucide="locate-fixed" class="w-4 h-4"></i> Use My Current GPS Location`;
              lucide.createIcons();
            },
            { enableHighAccuracy: true }
          );
        } else {
          alert("Geolocation is not supported by your browser.");
        }
      });

      function syncMapFromInputs() {
        const lat = parseFloat(latInput.value);
        const lng = parseFloat(lngInput.value);
        if (!isNaN(lat) && !isNaN(lng)) {
          marker.setLatLng([lat, lng]);
          map.panTo([lat, lng]);
        }
      }

      latInput.addEventListener('change', syncMapFromInputs);
      lngInput.addEventListener('change', syncMapFromInputs);
    });
  </script>
</body>
</html>