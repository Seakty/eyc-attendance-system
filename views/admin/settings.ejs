<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>EYC Attendance - Campus Settings</title>

  <link rel="icon" type="image/png" href="/images/favicon.ico" />

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Leaflet (OpenStreetMap) -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: "#4f46e5",
            secondary: "#6366f1",
          },
          fontFamily: {
            sans: ["Inter", "sans-serif"],
          },
        },
      },
    };
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <style>
    body {
      font-family: "Inter", sans-serif;
    }

    /* Leaflet paints square tiles over the rounded container */
    #map {
      overflow: hidden;
      z-index: 0;
    }

    /* Print styling rules */
    @media print {
      /* 1. Force the browser to print background colors! */
      * {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      /* 2. Remove the browser's default headers (URL, Date) */
      @page {
        margin: 0; 
      }
      body * {
        visibility: hidden;
      }
      #printable-poster, #printable-poster * {
        visibility: visible;
      }
      #printable-poster {
        position: absolute;
        left: 50%;
        top: 5%;
        transform: translateX(-50%);
        width: 85%;
        box-shadow: none !important;
        border: 2px solid #4f46e5 !important;
      }
      .no-print {
        display: none !important;
      }
    }
  </style>
</head>

<body class="bg-[#F9F7F6] text-slate-800">

  <!-- Toast notification -->
  <div id="alertBox" class="hidden fixed top-5 right-5 z-[60] max-w-sm rounded-xl px-4 py-3 text-sm font-medium shadow-lg"></div>

  <%
    const campusList = typeof campuses !== 'undefined' ? campuses : [];
    const currentSettings = typeof settings !== 'undefined' ? settings : { late_cutoff_time: '', latitude: '', longitude: '', radius_meters: '' };
    const activeCampusId = typeof selectedCampusId !== 'undefined'
      ? selectedCampusId
      : (campusList.length > 0 ? campusList[0].campus_id : 0);
    const initialQr = typeof qrCodeUrl !== 'undefined' && qrCodeUrl ? qrCodeUrl : '';
  %>

  <div class="flex min-h-screen">
    
    <%- include('../partials/sidebar', {
          user: typeof user !== 'undefined' ? user : null,
          path: typeof path !== 'undefined' ? path : ''
        }) %>

    <!-- ================= MAIN CONTENT ================= -->
    <main class="flex-1 min-w-0">
      
      <!-- Top Navbar Header -->
      <header class="no-print h-20 bg-white border-b border-slate-200 flex items-center justify-between px-5 lg:px-8">
        <div>
          <h2 class="text-xl font-bold text-slate-900">Campus Settings</h2>
          <p class="text-sm text-slate-500">Multi-campus geofence, cutoff times & QR posters</p>
        </div>

        <div class="flex items-center gap-3">
          <button class="relative w-10 h-10 rounded-xl border border-slate-200 flex items-center justify-center hover:bg-slate-50">
            <i data-lucide="bell" class="w-5 h-5 text-slate-600"></i>
            <span class="absolute top-2 right-2 w-2 h-2 bg-red-500 rounded-full"></span>
          </button>
        </div>
      </header>

      <div class="p-5 lg:p-8 space-y-8 max-w-4xl mx-auto">

        <!-- Main Settings Form Card -->
        <div class="no-print bg-white border border-slate-200 shadow-sm rounded-2xl p-6 lg:p-8">
          
          <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
              <i data-lucide="map-pin" class="w-5 h-5"></i>
            </div>
            <div>
              <h3 class="text-lg font-bold text-slate-900">Location & Attendance Rules</h3>
              <p class="text-xs text-slate-500">Each campus keeps its own coordinates, radius and cutoff time</p>
            </div>
          </div>

          <form action="/admin/settings" method="POST" id="settingsForm" data-ajax="true" class="space-y-6">

            <!-- Campus Selector -->
            <div>
              <label for="campusSelect" class="block text-xs font-semibold text-slate-600 uppercase mb-2">
                Campus <span class="text-red-500">*</span>
              </label>
              <select
                id="campusSelect"
                name="campus_id"
                required
                class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition text-sm"
              >
                <% campusList.forEach((campus) => { %>
                  <option
                    value="<%= campus.campus_id %>"
                    <%= campus.campus_id === activeCampusId ? 'selected' : '' %>
                  >
                    <%= campus.name %><%= campus.is_active ? '' : ' (inactive)' %>
                  </option>
                <% }) %>
              </select>
            </div>

            <!-- Interactive Map -->
            <div>
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-1">
                <label for="map" class="block text-xs font-semibold text-slate-600 uppercase">
                  Campus Location Map
                </label>
                <button
                  type="button"
                  id="locateBtn"
                  class="inline-flex items-center justify-center gap-2 bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 px-4 py-2 rounded-xl font-semibold text-xs transition shadow-sm"
                >
                  <i data-lucide="locate-fixed" class="w-4 h-4 text-indigo-600"></i>
                  Use My Current GPS Location
                </button>
              </div>

              <p class="text-xs text-slate-400 mb-2">
                Click anywhere on the map or drag the pin to set the campus coordinates.
              </p>

              <div id="map" class="h-80 w-full rounded-2xl border border-slate-200 my-4"></div>
            </div>

            <!-- Late Cutoff Time -->
            <div>
              <label for="late_cutoff_time" class="block text-xs font-semibold text-slate-600 uppercase mb-2">
                Late Cutoff Time <span class="text-red-500">*</span>
              </label>
              <input
                type="time"
                id="late_cutoff_time"
                name="late_cutoff_time"
                value="<%= currentSettings.late_cutoff_time || '' %>"
                required
                class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition text-sm"
              />
            </div>

            <!-- Two Column Grid for Lat/Lng -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <!-- Latitude -->
              <div>
                <label for="latitude" class="block text-xs font-semibold text-slate-600 uppercase mb-2">
                  School Latitude <span class="text-red-500">*</span>
                </label>
                <input
                  type="number"
                  step="any"
                  id="latitude"
                  name="latitude"
                  value="<%= currentSettings.latitude !== '' && currentSettings.latitude !== null && typeof currentSettings.latitude !== 'undefined' ? currentSettings.latitude : '' %>"
                  placeholder="e.g. 11.5564"
                  required
                  class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition text-sm"
                />
              </div>

              <!-- Longitude -->
              <div>
                <label for="longitude" class="block text-xs font-semibold text-slate-600 uppercase mb-2">
                  School Longitude <span class="text-red-500">*</span>
                </label>
                <input
                  type="number"
                  step="any"
                  id="longitude"
                  name="longitude"
                  value="<%= currentSettings.longitude !== '' && currentSettings.longitude !== null && typeof currentSettings.longitude !== 'undefined' ? currentSettings.longitude : '' %>"
                  placeholder="e.g. 104.9282"
                  required
                  class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition text-sm"
                />
              </div>
            </div>

            <!-- Allowed GPS Radius -->
            <div>
              <label for="radius_meters" class="block text-xs font-semibold text-slate-600 uppercase mb-2">
                Allowed GPS Radius (meters) <span class="text-red-500">*</span>
              </label>
              <input
                type="number"
                id="radius_meters"
                name="radius_meters"
                min="1"
                max="10000"
                step="1"
                value="<%= currentSettings.radius_meters || '' %>"
                placeholder="e.g. 50"
                required
                class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition text-sm"
              />
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              id="saveBtn"
              class="w-full inline-flex items-center justify-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 rounded-xl transition shadow-sm text-sm disabled:opacity-60 disabled:cursor-not-allowed"
            >
              <span
                id="saveSpinner"
                class="hidden h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"
                aria-hidden="true"
              ></span>
              <span id="saveBtnLabel">Save Settings &amp; Generate QR Code</span>
            </button>
          </form>
        </div>

        <!-- Entrance QR Poster Display Section -->
        <div id="qrSection" class="<%= initialQr ? '' : 'hidden' %> space-y-4">
          
          <!-- Action Buttons -->
          <div class="no-print flex flex-col sm:flex-row gap-3 justify-end">
            <button
              onclick="window.print()"
              class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2.5 rounded-xl font-semibold text-sm transition flex items-center justify-center gap-2 shadow-sm"
            >
              <i data-lucide="printer" class="w-4 h-4"></i>
              Print Poster
            </button>

            <a
              id="qrDownloadLink"
              href="<%= initialQr %>"
              download="EYC-Entrance-QR.png"
              class="bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 px-5 py-2.5 rounded-xl font-semibold text-sm transition flex items-center justify-center gap-2 text-center shadow-sm"
            >
              <i data-lucide="download" class="w-4 h-4 text-indigo-600"></i>
              Download Image
            </a>
          </div>

          <!-- Printable Poster Container -->
          <div id="printable-poster" class="bg-white border border-slate-200 shadow-sm rounded-2xl p-8 text-center space-y-6">
            <div class="flex justify-center items-center gap-3">
              <div class="p-2 bg-slate-50 rounded-2xl border border-slate-200">
                <img src="/images/eyc-logo.png" alt="EYC Logo" class="w-12 h-12 object-contain" />
              </div>
              <div class="text-left flex flex-col justify-center">
                  <h1 class="font-extrabold text-2xl tracking-tight text-slate-900">
                    EYC
                  </h1>
                  <p class="text-[11px] font-bold text-indigo-600 uppercase tracking-widest mt-1">
                    Empowering Youth
                  </p>
              </div>
            </div>

            <div>
              <h2 class="text-slate-900 text-2xl font-bold tracking-wide uppercase">ENTRANCE QR CODE</h2>
              <p class="text-indigo-600 text-sm font-semibold mt-1">Scan to Mark Daily Attendance</p>
              <p id="qrCampusName" class="text-slate-500 text-xs font-semibold mt-1 uppercase tracking-wide"><%= currentSettings.name || '' %></p>
            </div>

            <div class="flex justify-center">
              <div class="p-4 bg-slate-50 border-2 border-indigo-600 rounded-2xl inline-block shadow-sm">
                <img id="qrPrintImg" <% if (initialQr) { %>src="<%= initialQr %>"<% } %> alt="Entrance QR Code" class="w-64 h-64 object-contain" />
              </div>
            </div>

            <div class="max-w-md mx-auto space-y-1">
              <p class="text-slate-900 font-semibold text-sm">Please open the EYC Telegram App to scan</p>
              <p class="text-slate-500 text-xs">Align the QR scanner within the frame to record check-in or check-out times.</p>
            </div>
          </div>

        </div>

        <!-- Footer -->
        <p class="no-print text-center text-xs text-slate-400 pt-4">
          © <%= new Date().getFullYear() %> Empowering Youth in Cambodia (EYC)
        </p>

      </div>
    </main>
  </div>

  <!-- Leaflet JS -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <script>
    // Server-rendered page state (campuses + currently selected settings)
    window.SETTINGS_PAGE = <%- JSON.stringify({
          campuses: campusList,
          selectedCampusId: activeCampusId,
          settings: currentSettings,
          qrCodeUrl: initialQr,
        }).replace(/</g, "\\u003c") %>;
  </script>

  <script>
    (function () {
      const pageState = window.SETTINGS_PAGE;
      const initial = pageState.settings;

      // ---- Elements ----
      const form = document.getElementById("settingsForm");
      const campusSelect = document.getElementById("campusSelect");
      const cutoffInput = document.getElementById("late_cutoff_time");
      const latInput = document.getElementById("latitude");
      const lngInput = document.getElementById("longitude");
      const radiusInput = document.getElementById("radius_meters");
      const locateBtn = document.getElementById("locateBtn");
      const saveBtn = document.getElementById("saveBtn");
      const saveSpinner = document.getElementById("saveSpinner");
      const saveBtnLabel = document.getElementById("saveBtnLabel");

      function setSaving(isSaving) {
        saveBtn.disabled = isSaving;
        saveBtn.setAttribute("aria-busy", String(isSaving));
        saveSpinner.classList.toggle("hidden", !isSaving);
        saveBtnLabel.textContent = isSaving
          ? "Saving settings..."
          : "Save Settings & Generate QR Code";
      }

      // ---- Toast ----
      function showToast(message, type = "success") {
        const box = document.getElementById("alertBox");
        box.textContent = message;
        box.className =
          "fixed top-5 right-5 z-[60] max-w-sm rounded-xl px-4 py-3 text-sm font-medium shadow-lg";
        if (type === "success") {
          box.classList.add("bg-emerald-50", "text-emerald-700", "border", "border-emerald-200");
        } else {
          box.classList.add("bg-red-50", "text-red-700", "border", "border-red-200");
        }
        box.classList.remove("hidden");
        clearTimeout(window.__settingsToastTimer);
        window.__settingsToastTimer = setTimeout(() => box.classList.add("hidden"), 4000);
      }

      // ---- Map ----
      const startLat = Number(initial.latitude) || 11.5564;
      const startLng = Number(initial.longitude) || 104.9282;
      const startRadius = Number(initial.radius_meters) || 50;

      const map = L.map("map").setView([startLat, startLng], 16);

      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 19,
        attribution: "&copy; OpenStreetMap contributors",
      }).addTo(map);

      const marker = L.marker([startLat, startLng], { draggable: true }).addTo(map);

      const geofence = L.circle([startLat, startLng], {
        radius: startRadius,
        color: "#4f46e5",
        weight: 2,
        fillColor: "#6366f1",
        fillOpacity: 0.12,
      }).addTo(map);

      window.addEventListener("load", () => setTimeout(() => map.invalidateSize(), 100));

      // ---- Helpers ----
      function formatCoord(value) {
        return String(Math.round(Number(value) * 1e8) / 1e8);
      }

      function readLatitude() {
        return parseFloat(latInput.value);
      }

      function readLongitude() {
        return parseFloat(lngInput.value);
      }

      function readRadius() {
        return parseFloat(radiusInput.value);
      }

      function isValidLatLng(lat, lng) {
        return (
          Number.isFinite(lat) &&
          Number.isFinite(lng) &&
          Math.abs(lat) <= 90 &&
          Math.abs(lng) <= 180
        );
      }

      function applyPosition(lat, lng, pan) {
        if (!isValidLatLng(lat, lng)) return;
        const latlng = L.latLng(lat, lng);
        marker.setLatLng(latlng);
        geofence.setLatLng(latlng);
        if (pan && !map.getBounds().pad(0.15).contains(latlng)) {
          map.panTo(latlng);
        }
      }

      function applyRadius(radius) {
        if (Number.isFinite(radius) && radius > 0) {
          geofence.setRadius(radius);
        }
      }

      function writeInputsFromLatLng(lat, lng) {
        latInput.value = formatCoord(lat);
        lngInput.value = formatCoord(lng);
      }

      /** Fill the whole form + map from a settings payload (from GET or save response). */
      function populateForm(data, recenterMap) {
        if (data.late_cutoff_time) cutoffInput.value = data.late_cutoff_time;
        latInput.value = formatCoord(data.latitude);
        lngInput.value = formatCoord(data.longitude);
        radiusInput.value = data.radius_meters;
        applyPosition(Number(data.latitude), Number(data.longitude), false);
        applyRadius(Number(data.radius_meters));
        if (recenterMap) {
          map.setView([Number(data.latitude), Number(data.longitude)], 16);
        }
      }

      // ---- Map interactions ----
      // Draggable marker
      marker.on("dragend", function () {
        const latlng = marker.getLatLng();
        writeInputsFromLatLng(latlng.lat, latlng.lng);
        geofence.setLatLng(latlng);
      });

      // Click anywhere on the map
      map.on("click", function (event) {
        writeInputsFromLatLng(event.latlng.lat, event.latlng.lng);
        applyPosition(event.latlng.lat, event.latlng.lng, false);
      });

      // Live input binding: latitude / longitude move the pin
      latInput.addEventListener("input", function () {
        applyPosition(readLatitude(), readLongitude(), true);
      });

      lngInput.addEventListener("input", function () {
        applyPosition(readLatitude(), readLongitude(), true);
      });

      // Live input binding: radius rescales the geofence circle
      radiusInput.addEventListener("input", function () {
        applyRadius(readRadius());
      });

      // ---- "Use My Current GPS Location" ----
      locateBtn.addEventListener("click", function () {
        if (!navigator.geolocation) {
          showToast("Geolocation is not supported by this browser.", "error");
          return;
        }

        locateBtn.disabled = true;
        locateBtn.classList.add("opacity-60", "cursor-wait");

        navigator.geolocation.getCurrentPosition(
          function (position) {
            locateBtn.disabled = false;
            locateBtn.classList.remove("opacity-60", "cursor-wait");

            const lat = position.coords.latitude;
            const lng = position.coords.longitude;

            writeInputsFromLatLng(lat, lng);
            applyPosition(lat, lng, false);
            map.setView([lat, lng], 17);
            showToast("Map centered on your current GPS location.");
          },
          function (error) {
            locateBtn.disabled = false;
            locateBtn.classList.remove("opacity-60", "cursor-wait");
            showToast("Could not get your location: " + error.message, "error");
          },
          { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
        );
      });

      // ---- Campus selector: load that campus's saved settings ----
      campusSelect.addEventListener("change", async function () {
        const campusId = campusSelect.value;

        try {
          const response = await fetch(
            "/api/admin/settings/" + encodeURIComponent(campusId)
          );
          const result = await response.json().catch(() => ({}));

          if (!response.ok || result.status !== "success") {
            throw new Error(result.message || "Could not load campus settings.");
          }

          populateForm(result.data, true);
        } catch (error) {
          showToast(error.message, "error");
        }
      });

      // ---- QR poster refresh after a save ----
      function showQr(qrCodeUrl, campusName) {
        if (!qrCodeUrl) return;

        document.getElementById("qrPrintImg").src = qrCodeUrl;
        document.getElementById("qrDownloadLink").href = qrCodeUrl;

        const nameEl = document.getElementById("qrCampusName");
        if (nameEl && campusName) nameEl.textContent = campusName;

        const section = document.getElementById("qrSection");
        section.classList.remove("hidden");
        section.scrollIntoView({ behavior: "smooth", block: "start" });
      }

      // ---- Save (JSON API) ----
      form.addEventListener("submit", async function (event) {
        event.preventDefault();

        const body = {
          campus_id: Number(campusSelect.value),
          late_cutoff_time: cutoffInput.value,
          latitude: parseFloat(latInput.value),
          longitude: parseFloat(lngInput.value),
          radius_meters: parseInt(radiusInput.value, 10),
        };

        setSaving(true);

        try {
          const response = await fetch("/api/admin/settings", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(body),
          });

          const result = await response.json().catch(() => ({}));

          if (!response.ok || result.status !== "success") {
            throw new Error(result.message || "Could not save settings.");
          }

          showToast(result.message, "success");

          if (result.data) {
            populateForm(result.data, false);
          }

          showQr(result.qrCodeUrl, result.data && result.data.name);
        } catch (error) {
          showToast(error.message, "error");
        } finally {
          setSaving(false);
        }
      });

      // Initial paint (fixes floating-point display from DECIMAL columns)
      lucide.createIcons();
    })();
  </script>
</body>
</html>
